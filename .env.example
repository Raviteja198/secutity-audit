# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT — copy this file to .env and fill in real values.
# Set the same values in your hosting provider's dashboard (Render, Vercel, etc.)
# for production — whichever one is currently serving traffic.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Postgres — transaction-mode pooler (used by the app at runtime)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Postgres — session-mode pooler (used only for migrations)
DIRECT_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# NextAuth — use a long random string in production (e.g. `openssl rand -hex 32`)
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Must exactly match the origin currently serving the app (e.g. https://your-app.onrender.com
# or https://your-app.vercel.app) — used for callback URLs and cookie scoping.
NEXTAUTH_URL="http://localhost:3000"

# Canonical production URL — used for robots.txt, sitemap.xml, canonical/OG tags, and JSON-LD.
# Must match the domain set as the primary domain in Vercel and in Google Search Console.
NEXT_PUBLIC_SITE_URL="https://www.youthmanagment.com"

# Seed credentials (used by `npm run seed`)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Optional read-only viewer account
SEED_USER_EMAIL=""
SEED_USER_PASSWORD=""

# Google OAuth (Sign in with Google) — from Google Cloud Console
# Authorized redirect URI to register: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Secret your cron trigger (e.g. cron-job.org) sends as "Authorization: Bearer <value>"
# when invoking /api/cron/*. Generate with e.g. `openssl rand -hex 24`; must match the
# value configured on the cron trigger side.
CRON_SECRET=""

# When true, every outgoing email (receipts, OTPs, payment reminders, everything)
# is redirected to TEST_MODE_EMAIL instead of its real recipient — the original
# recipient stays visible in the subject line. Strongly recommended ON for any
# non-production environment (dev, preview) to avoid emailing real members.
TEST_MODE="true"
TEST_MODE_EMAIL="anumulaashok85@gmail.com"

# The only email allowed to use /system/onboard-tenant (creates new tenants).
# Checked server-side on every request; the endpoint refuses to work at all
# if this isn't set.
ONBOARDING_ALLOWED_EMAIL="anumulaashok85@gmail.com"

# Cloudinary — used to store tenant logo uploads. Get from your Cloudinary
# dashboard: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"

# SMTP credentials used to send payment reminder emails and receipts.
# For Gmail, use an App Password (not your login password): https://myaccount.google.com/apppasswords
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM=""
